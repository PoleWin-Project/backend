FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY --from=builder /app/dist ./dist
COPY swagger.yaml ./swagger.yaml
COPY public ./public

EXPOSE 8000
ENV NODE_ENV=production

CMD ["sh", "-c", "node dist/database/run-migrations.js up && node dist/server.js"]
