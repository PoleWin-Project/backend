# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development                    # development | test | production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── JWT / Auth secrets ────────────────────────────────────────────────────────
# Minimum 16 caractères. Les secrets optionnels fallback sur JWT_SECRET si non définis.
JWT_SECRET=change_me_at_least_16_chars
VERIFY_EMAIL_SECRET=change_me_at_least_16_chars
REFRESH_TOKEN_SECRET=change_me_at_least_16_chars
RESET_PASSWORD_SECRET=change_me_at_least_16_chars

# ── OpenF1 API (optionnel - version gratuite si absent) ───────────────────────
# Credentials du compte OpenF1 (https://openf1.org)
# Le token OAuth2 est obtenu automatiquement et renouvelé avant expiration (1h).
OPENF1_USERNAME=your_email@example.com
OPENF1_PASSWORD=your_password_here
