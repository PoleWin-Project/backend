# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development                    # development | test | production

# ── Database ──────────────────────────────────────────────────────────────────
# Backend lancé en local (hors Docker), avec la DB du docker-compose racine :
DATABASE_URL=postgresql://polewin:polewin@localhost:5432/polewindb
# NB : via `docker compose up backend` (racine), cette valeur est remplacée par
# celle du docker-compose (hôte postgres-db) — rien à changer ici.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origine du front web (Expo web tourne sur le port 8081). `*` toléré en dev.
CORS_ORIGIN=http://localhost:8081

# ── JWT / Auth secrets ────────────────────────────────────────────────────────
# JWT_SECRET : minimum 32 caractères — générer avec : openssl rand -hex 32
# Les 3 secrets suivants sont optionnels en dev (fallback sur JWT_SECRET)
# mais obligatoires ET distincts en production (cf. src/config/env.ts).
JWT_SECRET=dev_jwt_secret_change_me_32_chars_minimum
# VERIFY_EMAIL_SECRET=
# REFRESH_TOKEN_SECRET=
# RESET_PASSWORD_SECRET=

# ── Auth Google (vérification des tokens côté serveur) ────────────────────────
# Mêmes valeurs que dans frontend/.env (https://console.cloud.google.com/apis/credentials).
# Sans elles, le login Google échoue côté API — le reste de l'app fonctionne.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# ── OpenF1 API (optionnel — version gratuite si absent) ───────────────────────
# Credentials du compte OpenF1 (https://openf1.org). Le token OAuth2 est obtenu
# automatiquement et renouvelé avant expiration (1h). Laisser commenté si pas de compte.
# OPENF1_USERNAME=your_email@example.com
# OPENF1_PASSWORD=your_password_here

# ── Optionnel ─────────────────────────────────────────────────────────────────
# SENTRY_DSN=                # monitoring erreurs
# RESEND_API_KEY=            # envoi d'emails via Resend (https://resend.com)
# SMTP_FROM=PoleWin <no-reply@polewin.fr>
# APP_URL=http://localhost:8000
